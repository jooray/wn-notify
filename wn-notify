#!/usr/bin/env python3
"""Small same-user agent-control v2 notification client; stdlib only."""
import argparse
import json
import mimetypes
import os
from pathlib import Path
import re
import socket
import stat
import sys
import tempfile
import uuid

VERSION = "1.0.0"
PROTOCOL = "marmot.agent-control.v2"
FRAME_LIMIT = 1024 * 1024
FILE_LIMIT = 512 * 1024 * 1024 - 16


class NotifyError(Exception):
    pass


def private_json(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "r") as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise NotifyError("configuration must be an owner-only regular file")
        if info.st_size > FRAME_LIMIT:
            raise NotifyError("configuration is too large")
        return json.load(stream)


def write_private_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    if path.parent.is_symlink():
        raise NotifyError("configuration directory cannot be a symlink")
    fd, tmp = tempfile.mkstemp(prefix=".config-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(value, stream, indent=2)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def envelope(payload, token=None):
    result = {"marmot_agent_control": PROTOCOL, "id": str(uuid.uuid4()), **payload}
    if token:
        result["auth_token"] = token
    data = (json.dumps(result, ensure_ascii=False) + "\n").encode()
    if len(data) > FRAME_LIMIT:
        raise NotifyError("request exceeds the control-frame limit")
    return result["id"], data


def read_frame(stream):
    data = stream.readline(FRAME_LIMIT + 1)
    if not data or not data.endswith(b"\n") or len(data) > FRAME_LIMIT:
        raise NotifyError("connector closed the connection or returned an invalid frame")
    result = json.loads(data)
    if result.get("marmot_agent_control") != PROTOCOL:
        raise NotifyError("connector protocol mismatch")
    return result


def call(config, payload, timeout=30):
    request_id, data = envelope(payload)
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(timeout)
        sock.connect(config["socket"])
        sock.sendall(data)
        with sock.makefile("rb") as stream:
            result = read_frame(stream)
    if result.get("id") != request_id:
        raise NotifyError("connector response id mismatch")
    if result.get("type") == "error":
        code = result.get("code", "unknown")
        if not isinstance(code, str) or not re.fullmatch(r"[a-z0-9_]{1,128}", code):
            code = "unknown"
        raise NotifyError(f"connector rejected request ({code})")
    return result


def valid_hex(value):
    return isinstance(value, str) and re.fullmatch(r"(?:[a-fA-F0-9]{2}){1,256}", value) is not None


def selected(config):
    group = os.environ.get("WN_DESTINATION", config.get("group_id_hex", ""))
    if not valid_hex(group):
        raise NotifyError("no valid destination: invite the notification identity, then use wn-notify bind GROUP_ID")
    return {"account_id_hex": config["account_id_hex"], "group_id_hex": group}


def send(config, payload, key, timeout=30):
    try:
        result = call(config, {**payload, "idempotency_key": key}, timeout)
    except (NotifyError, OSError) as error:
        raise NotifyError(f"send not confirmed; retry with --idempotency-key {key}: {error}") from error
    if result.get("type") != "final_sent" or not result.get("message_ids_hex"):
        raise NotifyError(f"send not confirmed; retry with --idempotency-key {key}")
    print(f"Published to group relays (not a recipient read receipt). Idempotency key: {key}")


def send_text(config, text, key):
    if not text.strip():
        raise NotifyError("message cannot be empty")
    if len(text.encode()) > 60000:
        raise NotifyError("message exceeds 60000 UTF-8 bytes; use wn-file")
    send(config, {"type": "send_final", **selected(config), "text": text}, key)


def send_file(config, source, caption, key):
    # Read only a regular, non-symlink leaf; copy into the connector's one allowed root.
    destination = selected(config)
    root = Path(config["staging_root"])
    info = root.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise NotifyError("staging root must be an owner-only real directory")
    fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as stream:
        before = os.fstat(stream.fileno())
        if not stat.S_ISREG(before.st_mode) or before.st_size > FILE_LIMIT:
            raise NotifyError("file must be regular and smaller than the connector's 512 MiB cap")
        with tempfile.TemporaryDirectory(prefix="send-", dir=root) as batch:
            staged = Path(batch) / "attachment"
            with staged.open("xb") as output:
                os.chmod(staged, 0o600)
                remaining = before.st_size
                while remaining:
                    chunk = stream.read(min(1024 * 1024, remaining))
                    if not chunk:
                        raise NotifyError("source changed while staging")
                    output.write(chunk)
                    remaining -= len(chunk)
                if stream.read(1):
                    raise NotifyError("source grew while staging")
            after = os.fstat(stream.fileno())
            if (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (after.st_size, after.st_mtime_ns, after.st_ctime_ns):
                raise NotifyError("source changed while staging")
            name = Path(source).name
            payload = {"type": "send_media", **destination,
                       "attachments": [{"path": str(staged), "media_type": mimetypes.guess_type(name)[0] or "application/octet-stream", "file_name": name}],
                       "caption": caption}
            # One attachment may try three Blossom servers with fifteen-minute deadlines.
            send(config, payload, key, timeout=46 * 60)


def listen(config, timeout):
    request_id, data = envelope({"type": "subscribe_inbound", "account_id_hex": config["account_id_hex"], "group_id_hex": None})
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(timeout)
        sock.connect(config["socket"])
        sock.sendall(data)
        with sock.makefile("rb") as stream:
            ack = read_frame(stream)
            if ack.get("id") != request_id or ack.get("type") != "ack":
                raise NotifyError("could not subscribe to notifications")
            print("Waiting for group events. Send a message from White Noise to discover its group id.", flush=True)
            while True:
                event = read_frame(stream)
                group = event.get("group_id_hex")
                if valid_hex(group):
                    print(f"Group {group} ({event.get('type', 'event')}); bind with: wn-notify bind {group}", flush=True)


def parser():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--version", action="version", version=f"wn-notify {VERSION}")
    sub = p.add_subparsers(dest="command", required=True)
    for name in ("identity", "status"):
        sub.add_parser(name)
    bind = sub.add_parser("bind", help="explicitly select an admitted group")
    bind.add_argument("group_id_hex")
    watch = sub.add_parser("listen", help="discover groups, without printing message text")
    watch.add_argument("--timeout", type=int, default=300)
    msg = sub.add_parser("msg")
    msg.add_argument("--idempotency-key")
    msg.add_argument("text", nargs="*")
    file = sub.add_parser("file")
    file.add_argument("--idempotency-key")
    file.add_argument("path")
    file.add_argument("caption", nargs="*")
    create = sub.add_parser("create-group", help="create once; timeout may be ambiguous, never retry blindly")
    create.add_argument("--name", required=True)
    create.add_argument("--member", action="append", required=True)
    return p


def main():
    argv = sys.argv[1:]
    invoked = Path(sys.argv[0]).name
    if invoked in ("wn-msg", "wn-stdin"):
        argv.insert(0, "msg")
    elif invoked == "wn-file":
        argv.insert(0, "file")
    args = parser().parse_args(argv)
    home = Path(os.environ.get("WN_NOTIFY_HOME", str(Path.home() / ".marmot-agents/notify")))
    path = home / "notify.json"
    config = private_json(path)
    if not re.fullmatch(r"[a-fA-F0-9]{64}", config.get("account_id_hex", "")):
        raise NotifyError("configuration has no valid notification account id")
    if args.command == "identity":
        identity = private_json(home / "bootstrap.json")
        print(identity["npub"])
        print(identity["nprofile"])
    elif args.command == "status":
        result = call(config, {"type": "diagnostic_status", "account_id_hex": config["account_id_hex"], "home_group_id_hex": config.get("group_id_hex")})
        if result.get("type") != "diagnostic_status":
            raise NotifyError("unexpected diagnostic response")
        print(json.dumps(result.get("report"), indent=2))
        print("Destination:", config.get("group_id_hex") or "not bound")
    elif args.command == "bind":
        if not valid_hex(args.group_id_hex):
            raise NotifyError("group id must be an even-length opaque hex id")
        result = call(config, {"type": "group_info", "account_id_hex": config["account_id_hex"], "group_id_hex": args.group_id_hex})
        if result.get("type") != "group_info":
            raise NotifyError("group membership could not be confirmed")
        config["group_id_hex"] = args.group_id_hex.lower()
        write_private_json(path, config)
        print("Notification destination bound.")
    elif args.command == "listen":
        listen(config, args.timeout)
    elif args.command == "create-group":
        result = call(config, {"type": "group_create", "account_id_hex": config["account_id_hex"], "name": args.name, "members": args.member}, timeout=120)
        if result.get("type") != "group_created" or not valid_hex(result.get("group_id_hex")):
            raise NotifyError("group creation not confirmed; inspect state before retrying")
        config["group_id_hex"] = result["group_id_hex"]
        write_private_json(path, config)
        print("Group created and bound:", result["group_id_hex"])
        print("Accept the invite in White Noise; add other device/host identities there.")
    elif args.command == "msg":
        text = " ".join(args.text) if args.text else sys.stdin.read(60001)
        send_text(config, text, args.idempotency_key or str(uuid.uuid4()))
    elif args.command == "file":
        send_file(config, args.path, " ".join(args.caption) or None, args.idempotency_key or str(uuid.uuid4()))


if __name__ == "__main__":
    try:
        main()
    except (NotifyError, OSError, ValueError, KeyError) as exc:
        print(f"wn-notify: {exc}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print("wn-notify: interrupted; delivery may be uncertain", file=sys.stderr)
        sys.exit(130)
